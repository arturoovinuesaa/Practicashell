

#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <signal.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <fcntl.h>
#include <errno.h>
#include "parser.h"

#define MAX_JOBS 100
#define RUNNING "Running"
#define STOPPED "Stopped"
#define DONE    "Done"

/* =====================
   ESTRUCTURAS DE JOBS
   ===================== */

typedef struct {
    pid_t pgid;
    int id;
    char *command;
    char status[16];
    int nprocs;
} job_t;

static job_t jobs[MAX_JOBS];
static int next_job_id = 1;
static pid_t fg_pgid = 0;

/* =====================
   UTILIDADES DE JOBS
   ===================== */

void init_jobs(void)
{
    int i;
    for (i = 0; i < MAX_JOBS; i++) {
        jobs[i].pgid = 0;
        jobs[i].command = NULL;
    }
}

char *build_command(tline *line)
{
    int i, j, len = 0;
    char *cmd;

    for (i = 0; i < line->ncommands; i++) {
        for (j = 0; line->commands[i].argv[j]; j++)
            len += strlen(line->commands[i].argv[j]) + 1;
        if (i < line->ncommands - 1)
            len += 2; /* | */
    }
    if (line->background)
        len += 2; /* & */

    cmd = malloc(len + 1);
    if (!cmd) return NULL;
    cmd[0] = '\0';

    for (i = 0; i < line->ncommands; i++) {
        if (i > 0) strcat(cmd, "| ");
        for (j = 0; line->commands[i].argv[j]; j++) {
            strcat(cmd, line->commands[i].argv[j]);
            strcat(cmd, " ");
        }
    }
    if (line->background)
        strcat(cmd, "&");

    return cmd;
}

void add_job(pid_t pgid, char *cmd, const char *status, int nprocs)
{
    int i;
    for (i = 0; i < MAX_JOBS; i++) {
        if (jobs[i].pgid == 0) {
            jobs[i].pgid = pgid;
            jobs[i].id = next_job_id++;
            jobs[i].command = cmd;
            jobs[i].nprocs = nprocs;
            strncpy(jobs[i].status, status, sizeof(jobs[i].status));
            printf("[%d] %d\n", jobs[i].id, pgid);
            return;
        }
    }
    fprintf(stderr, "msh: job list full\n");
    free(cmd);
}

void remove_job(pid_t pgid)
{
    int i;
    for (i = 0; i < MAX_JOBS; i++) {
        if (jobs[i].pgid == pgid) {
            free(jobs[i].command);
            jobs[i].pgid = 0;
            jobs[i].command = NULL;
            return;
        }
    }
}

job_t *find_job_by_id(int id)
{
    int i;
    for (i = 0; i < MAX_JOBS; i++)
        if (jobs[i].pgid && jobs[i].id == id)
            return &jobs[i];
    return NULL;
}

job_t *last_stopped_job(void)
{
    int i;
    job_t *res = NULL;
    for (i = 0; i < MAX_JOBS; i++)
        if (jobs[i].pgid && strcmp(jobs[i].status, STOPPED) == 0)
            if (!res || jobs[i].id > res->id)
                res = &jobs[i];
    return res;
}

/* =====================
   BUILT-INS
   ===================== */

void builtin_cd(char *path)
{
    char cwd[1024];
    if (!path)
        path = getenv("HOME");
    if (chdir(path) < 0)
        perror("msh: cd");
    else if (getcwd(cwd, sizeof(cwd)))
        printf("%s\n", cwd);
}

void builtin_jobs(void)
{
    int i;
    for (i = 0; i < MAX_JOBS; i++)
        if (jobs[i].pgid)
            printf("[%d]  %-8s %s\n",
                   jobs[i].id, jobs[i].status, jobs[i].command);
}

void builtin_bg(char *arg)
{
    job_t *job;

    if (arg)
        job = find_job_by_id(atoi(arg));
    else
        job = last_stopped_job();

    if (!job) {
        fprintf(stderr, "msh: bg: no such job\n");
        return;
    }

    kill(-job->pgid, SIGCONT);
    strcpy(job->status, RUNNING);
    printf("[%d] %s &\n", job->id, job->command);
}

void builtin_umask(char **argv)
{
    if (!argv[1]) {
        mode_t m = umask(0);
        umask(m);
        printf("%04o\n", m);
    } else {
        char *end;
        long val = strtol(argv[1], &end, 8);
        if (*end || val < 0 || val > 0777) {
            fprintf(stderr, "msh: umask: invalid value\n");
            return;
        }
        umask((mode_t)val);
    }
}

/* =====================
   SEÑALES
   ===================== */

void sigint_handler(int sig)
{
    if (fg_pgid > 0)
        kill(-fg_pgid, SIGINT);
}

void sigtstp_handler(int sig)
{
    if (fg_pgid > 0)
        kill(-fg_pgid, SIGTSTP);
}

void setup_signals(void)
{
    signal(SIGINT, sigint_handler);
    signal(SIGTSTP, sigtstp_handler);
    signal(SIGTTOU, SIG_IGN);
    signal(SIGTTIN, SIG_IGN);
}

/* =====================
   REDIRECCIONES
   ===================== */

int apply_redirs(tline *l, int i)
{
    int fd;

    if (i == 0 && l->redirect_input) {
        fd = open(l->redirect_input, O_RDONLY);
        if (fd < 0) {
            fprintf(stderr, "%s: Error. %s\n", l->redirect_input, strerror(errno));
            return -1;
        }
        dup2(fd, STDIN_FILENO);
        close(fd);
    }

    if (i == l->ncommands - 1 && l->redirect_output) {
        fd = open(l->redirect_output, O_CREAT | O_WRONLY | O_TRUNC, 0666);
        if (fd < 0) {
            fprintf(stderr, "%s: Error. %s\n", l->redirect_output, strerror(errno));
            return -1;
        }
        dup2(fd, STDOUT_FILENO);
        close(fd);
    }

    if (i == l->ncommands - 1 && l->redirect_error) {
        fd = open(l->redirect_error, O_CREAT | O_WRONLY | O_TRUNC, 0666);
        if (fd < 0) {
            fprintf(stderr, "%s: Error. %s\n", l->redirect_error, strerror(errno));
            return -1;
        }
        dup2(fd, STDERR_FILENO);
        close(fd);
    }

    return 0;
}

/* =====================
   EJECUCIÓN
   ===================== */

void execute_line(tline *l)
{
    int i, fd[2], in = -1;
    pid_t pid, pgid = 0;

    /* built-ins sin pipes */
    if (l->ncommands == 1) {
        char *cmd = l->commands[0].argv[0];
        if (!strcmp(cmd, "exit")) exit(0);
        if (!strcmp(cmd, "cd")) { builtin_cd(l->commands[0].argv[1]); return; }
        if (!strcmp(cmd, "jobs")) { builtin_jobs(); return; }
        if (!strcmp(cmd, "bg")) { builtin_bg(l->commands[0].argv[1]); return; }
        if (!strcmp(cmd, "umask")) { builtin_umask(l->commands[0].argv); return; }
    }

    for (i = 0; i < l->ncommands; i++) {
        if (i < l->ncommands - 1)
            pipe(fd);

        pid = fork();

        if (pid == 0) {
            signal(SIGINT, SIG_DFL);
            signal(SIGTSTP, SIG_DFL);

            if (i == 0) setpgid(0, 0);
            else setpgid(0, pgid);

            if (in != -1) { dup2(in, STDIN_FILENO); close(in); }
            if (i < l->ncommands - 1) {
                dup2(fd[1], STDOUT_FILENO);
                close(fd[0]); close(fd[1]);
            }

            if (apply_redirs(l, i) < 0) exit(1);

            execvp(l->commands[i].argv[0], l->commands[i].argv);
            printf("%s: No se encuentra el mandato\n", l->commands[i].argv[0]);
            exit(1);
        }

        if (i == 0) {
            pgid = pid;
            setpgid(pid, pid);
            if (!l->background)
                tcsetpgrp(STDIN_FILENO, pgid);
        } else setpgid(pid, pgid);

        if (in != -1) close(in);
        if (i < l->ncommands - 1) {
            close(fd[1]);
            in = fd[0];
        }
    }

    if (l->background) {
        add_job(pgid, build_command(l), RUNNING, l->ncommands);
    } else {
        fg_pgid = pgid;
        while (waitpid(-pgid, NULL, WUNTRACED) > 0);
        tcsetpgrp(STDIN_FILENO, getpid());
        fg_pgid = 0;
    }
}

/* =====================
   MAIN
   ===================== */

int main(void)
{
    char buf[1024];
    tline *line;

    init_jobs();
    setup_signals();

    while (1) {
        printf("msh> ");
        if (!fgets(buf, sizeof(buf), stdin)) break;
        line = tokenize(buf);
        if (!line || line->ncommands == 0) { free(line); continue; }
        execute_line(line);
        free(line);
    }
    return 0;
}
