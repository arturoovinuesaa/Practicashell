#define RUNNING "Running"
#define STOPPED "Stopped"
#define DONE "Done"

#define MAX_JOBS 100

// Estructura para almacenar la información de un trabajo (Job)
typedef struct {
    pid_t pgid;         // Process Group ID (Identifica toda la tubería)
    int id;             // ID del job (1, 2, 3...)
    char *command;      // Comando completo
    char status[20];    // Estado (Running, Stopped, Done)
} job_t;

job_t jobs_list[MAX_JOBS];
int job_counter = 0; // Contador para asignar IDs secuenciales
pid_t fg_pgid = 0;   // ID del grupo de proceso en Foreground (0 si no hay)
// Inicializa la lista de jobs
void init_jobs()
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        jobs_list[i].pgid = 0;
        jobs_list[i].command = NULL;
        jobs_list[i].nprocs = 0;
    }
}

// Reconstruye el comando completo en un string para el job
char *get_command_string(tline *line)
{
    char *cmd_str = NULL;
    int total_len = 0;
    int i;

    // Calcular longitud total
    for (i = 0; i < line->ncommands; i++)
    {
        for (int j = 0; line->commands[i].argv[j] != NULL; j++)
        {
            total_len += strlen(line->commands[i].argv[j]) + 1; // +1 para el espacio
        }
        if (i < line->ncommands - 1)
            total_len += 3; // " | "
    }
    if (line->background)
        total_len += 3; // " &"

    cmd_str = (char *)malloc(total_len + 1); // +1 para el null terminator
    if (cmd_str == NULL)
        return NULL;
    cmd_str[0] = '\0';

    for (i = 0; i < line->ncommands; i++)
    {
        if (i > 0)
            strcat(cmd_str, " | ");
        for (int j = 0; line->commands[i].argv[j] != NULL; j++)
        {
            strcat(cmd_str, line->commands[i].argv[j]);
            strcat(cmd_str, " ");
        }
        // Quitar el último espacio si se ha añadido
        if (cmd_str[strlen(cmd_str) - 1] == ' ')
            cmd_str[strlen(cmd_str) - 1] = '\0';
    }
    if (line->background)
        strcat(cmd_str, " &");

    return cmd_str;
}

// Añadir un job a la lista
void add_job(pid_t pgid, char *cmd, char *status, int nprocs)
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (jobs_list[i].pgid == 0)
        { // Hueco libre
            jobs_list[i].pgid = pgid;
            jobs_list[i].id = ++job_counter;
            jobs_list[i].command = cmd; 
            jobs_list[i].nprocs = nprocs;
            strncpy(jobs_list[i].status, status, sizeof(jobs_list[i].status) - 1);
            jobs_list[i].status[sizeof(jobs_list[i].status) - 1] = '\0';
            jobs_list[i].command = cmd;
            strcpy(jobs_list[i].status, status);
            // Imprimir [PGID] para jobs en background (sin job_id)
            if (strcmp(status, RUNNING) == 0)
            {
                printf("[%d] %d\n", jobs_list[i].id, pgid);
            }
            else
            {
                // Para jobs STOPPED, imprimir con formato diferente
                printf("[%d]+ %d\n", jobs_list[i].id, pgid);
            }
            return;
        }
    }
    free(cmd);
    fprintf(stderr, "Error: Lista de jobs llena. Job %d no registrado.\n", pgid);
}

// Eliminar un job por PGID
int remove_job_by_pgid(pid_t pgid)
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (jobs_list[i].pgid == pgid)
        {
            free(jobs_list[i].command);
            jobs_list[i].pgid = 0;
            jobs_list[i].id = 0;
            jobs_list[i].command = NULL;
            return 1; // Encontrado y eliminado
        }
    }
    return 0; // No encontrado
}

// Buscar job por ID
job_t *get_job_by_id(int id)
{
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (jobs_list[i].id == id && jobs_list[i].pgid != 0)
        {
            return &jobs_list[i];
        }
    }
    return NULL;
}

// Buscar el último job parado
job_t *get_last_stopped_job()
{
    // Implementación simple: busca el de mayor ID parado
    job_t *last_job = NULL;
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (jobs_list[i].pgid != 0 && strcmp(jobs_list[i].status, STOPPED) == 0)
        {
            if (last_job == NULL || jobs_list[i].id > last_job->id)
            {
                last_job = &jobs_list[i];
            }
        }
    }
    return last_job;
}

void exitshell()
{
    // Send SIGTERM to all active jobs
    for (int i = 0; i < MAX_JOBS; i++) {
        if (jobs_list[i].pgid != 0) {
            kill(-jobs_list[i].pgid, SIGTERM);
        }
    }
    
    // Free all dynamic memory
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (jobs_list[i].command != NULL)
            {
            free(jobs_list[i].command);
        }
    }
    
    exit(0);
}

void cdshell(char *path)
{
    char *dir;
    char buffer[1024]; // Buffer para guardar la ruta actual
    if (path == NULL)
    {
        dir = getenv("HOME");
    }
    else
    {
        dir = path;
    }
    if (chdir(dir) != 0)
    {
        perror("msh: cd error");
    }
    else
    {
        if (getcwd(buffer, sizeof(buffer)) != NULL)
        {
            printf("%s\n", buffer);
        }
    }
}
void jobshell()
{
    // Find the current job (highest ID or most recent)
    int current_id = -1;
    int previous_id = -1;
    int max_id = 0;
    
    // First pass: find the two highest IDs
    for (int i = 0; i < MAX_JOBS; i++) {
        if (jobs_list[i].pgid != 0) {
            if (jobs_list[i].id > max_id) {
                previous_id = max_id;
                max_id = jobs_list[i].id;
                current_id = max_id;
            } else if (jobs_list[i].id > previous_id) {
                previous_id = jobs_list[i].id;
            }
        }
    }
    
    // Second pass: print jobs with proper markers
    for (int i = 0; i < MAX_JOBS; i++)
    {
        if (jobs_list[i].pgid != 0)
        {
            char marker = ' ';
            if (jobs_list[i].id == current_id) {
                marker = '+';
            } else if (jobs_list[i].id == previous_id) {
                marker = '-';
            }
            printf("[%d]%c  %-20s %s\n",
                   jobs_list[i].id, marker, jobs_list[i].status, jobs_list[i].command);
        }
    }
}
void bgshell(char *arg)
{
    job_t *job = NULL;

    // Si se proporciona un argumento, buscamos ese job
    if (arg != NULL)
    {
        int job_id = atoi(arg);
        job = get_job_by_id(job_id);
        if (job == NULL)
        {
            fprintf(stderr, "msh: bg: %d: no such job\n", job_id);
            return;
        }
    }
    else
    {
        // Sin argumento, buscar el último job parado
        job = get_last_stopped_job();
        if (job == NULL)
        {
            fprintf(stderr, "msh: bg: current: no such job\n");
            return;
        }
    }

    // Enviar SIGCONT al grupo de procesos
    if (kill(-job->pgid, SIGCONT) < 0)
    {
        perror("msh: bg: kill");
        return;
    }

    // Actualizar estado a RUNNING
    strncpy(job->status, RUNNING, sizeof(job->status) - 1);
    job->status[sizeof(job->status) - 1] = '\0';
    
    // Mostrar información del job
    printf("[%d]+ %s &\n", job->id, job->command);
}

void zombies() {
    int status;
    pid_t result;

    // Iteramos por cada job registrado para ver si sus procesos han cambiado
    for (int i = 0; i < MAX_JOBS; i++) {
        if (jobs_list[i].pgid == 0) continue; // Saltamos huecos vacíos

        // Usamos el PGID negativo para esperar solo a procesos de ESTE job
        // Esto evita confundir procesos de distintos jobs
        while ((result = waitpid(-jobs_list[i].pgid, &status, WNOHANG | WUNTRACED | WCONTINUED)) > 0) {
            
            if (WIFSTOPPED(status)) {
                strncpy(jobs_list[i].status, STOPPED, sizeof(jobs_list[i].status) - 1);
                jobs_list[i].status[sizeof(jobs_list[i].status) - 1] = '\0';
                printf("[%d]+ Stopped %s\n", jobs_list[i].id, jobs_list[i].command);
            } 
            else if (WIFCONTINUED(status)) {
                strncpy(jobs_list[i].status, RUNNING, sizeof(jobs_list[i].status) - 1);
                jobs_list[i].status[sizeof(jobs_list[i].status) - 1] = '\0';
                // Opcional: imprimir que continúa
            } 
            else if (WIFEXITED(status) || WIFSIGNALED(status)) {
                jobs_list[i].nprocs--;
                if (jobs_list[i].nprocs <= 0) {
                    printf("[%d]+ Done %s\n", jobs_list[i].id, jobs_list[i].command);
                    remove_job_by_pgid(jobs_list[i].pgid);
                    break; // El job ya no existe, salimos del while
                }
            }
        }
    }
}

void umaskshell(char **argv, int has_pipes)
{
    // Reject if there are pipes
    if (has_pipes) {
        fprintf(stderr, "msh: umask: cannot be used with pipes\n");
        return;
    }
    
    // No arguments - display current mask
    if (argv[1] == NULL) {
        mode_t current_mask = umask(0); // Get current mask
        umask(current_mask); // Restore it
        printf("%04o\n", current_mask);
    } else {
        // Parse octal argument
        char *endptr;
        long new_mask = strtol(argv[1], &endptr, 8);
        
        // Validate the input
        if (*endptr != '\0' || new_mask < 0 || new_mask > 0777) {
            fprintf(stderr, "msh: umask: %s: octal number out of range\n", argv[1]);
            return;
        }
        
        // Set new mask
        umask((mode_t)new_mask);
    }
}
// Signal handler for Ctrl+Z - only sends SIGTSTP to foreground group
void sigtstp_handler(int sig)

    while ((pid = waitpid(-1, &status, WNOHANG | WUNTRACED | WCONTINUED)) > 0)
    {
        // Buscar el job que contiene este PID
        for (int i = 0; i < MAX_JOBS; i++)
        {
            if (jobs_list[i].pgid == 0)
                continue;

            // Verificar si el PID pertenece a este grupo
            pid_t pgid_of_pid = getpgid(pid);
            if (pgid_of_pid == jobs_list[i].pgid)
            {
                if (WIFEXITED(status) || WIFSIGNALED(status))
                {
                    // Proceso terminó - verificar si todos los procesos del pipeline terminaron
                    // Para simplificar, intentamos esperar a más procesos del mismo PGID
                    int all_done = 1;

                    // Verificar si hay más procesos vivos en este PGID
                    // Si kill devuelve 0, el grupo aún existe
                    if (kill(-jobs_list[i].pgid, 0) == 0)
                    {
                        all_done = 0; // Aún hay procesos vivos
                    }

                    if (all_done)
                    {
                        // Todos los procesos terminaron - marcar job como Done
                        strcpy(jobs_list[i].status, DONE);
                        printf("\n[%d]+  Done                    %s\n",
                               jobs_list[i].id, jobs_list[i].command);
                        // Eliminar el job de la lista
                        remove_job_by_pgid(jobs_list[i].pgid);
                    }
                }
                else if (WIFSTOPPED(status))
                {
                    // Proceso fue detenido
                    strcpy(jobs_list[i].status, STOPPED);
                }
                else if (WIFCONTINUED(status))
                {
                    // Proceso continuó
                    strcpy(jobs_list[i].status, RUNNING);
                }
                break;
            }
        }
    }
}

