// cuando creas un job siempre lo mandas la back, pero si es del fr vas a esperar hassta que termine
void sigtstp_handler() // hacer que solo se haga signtstp con los del foreground
{
    if (fg_pgid > 0)
    {
        // Send SIGTSTP to the foreground process group
        kill(-fg_pgid, SIGTSTP);

        // Buscar si el job ya existe en la lista
        for (int i = 0; i < MAX_JOBS; i++)
        {
            if (jobs_list[i].pgid == fg_pgid)
            {
                strcpy(jobs_list[i].status, STOPPED);
                printf("\n[%d]+  Stopped                 %s\n",
                       jobs_list[i].id, jobs_list[i].command);
                break;
            }
        }

        // Si no existe, necesitamos crearlo (pero no tenemos el comando aquí)
        // La solución correcta es crear el job ANTES en ejecutar_linea
    }
    write(STDOUT_FILENO, "msh> ", 5);
        // Do not modify jobs list here - not async-signal-safe
        // Job creation happens in ejecutar_linea() when WIFSTOPPED is detected
    }
}
void sigint_handler()
{
    if (fg_pgid > 0)
    {
        // Enviar SIGINT al grupo de procesos en foreground
        kill(-fg_pgid, SIGINT);
    }
    // Do not print prompt here - not async-signal-safe
}
void activarsignal()
{
    /* Ignorar señales de terminal para que la shell no sea parada al cambiar
       el proceso en primer plano (SIGTTOU, SIGTTIN). */
    signal(SIGTTOU, SIG_IGN);
    signal(SIGTTIN, SIG_IGN);

    signal(SIGINT, sigint_handler);
    signal(SIGTSTP, sigtstp_handler);
}

int aplicar_redirecciones(tline *line, int cmd_index)
{
    int fd;
    if (cmd_index == 0 && line->redirect_input != NULL)
    {
        fd = open(line->redirect_input, O_RDONLY);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_input, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDIN_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }
    if (cmd_index == line->ncommands - 1 && line->redirect_output != NULL)
    {
        fd = open(line->redirect_output, O_WRONLY | O_CREAT | O_TRUNC, 0666);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_output, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDOUT_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }
    if (cmd_index == line->ncommands - 1 && line->redirect_error != NULL)
    {
        fd = open(line->redirect_error, O_WRONLY | O_CREAT | O_TRUNC, 0666);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_error, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDERR_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }

    return 0;
}

void ejecutar_linea(tline *line)
{
    // 1. Comandos internos (built-ins) que deben ejecutarse en el proceso padre
    if (line->ncommands == 1)
    {
        if (strcmp(line->commands[0].argv[0], "exit") == 0)
            exitshell();
        if (strcmp(line->commands[0].argv[0], "cd") == 0)
        {
            cdshell(line->commands[0].argv[1]);
            return;
        }
        if (strcmp(line->commands[0].argv[0], "jobs") == 0)
        {
            jobshell();
            return;
        }
        if (strcmp(line->commands[0].argv[0], "bg") == 0)
        {
            bgshell(line->commands[0].argv[1]);
            return;
        }
        if (strcmp(line->commands[0].argv[0], "umask") == 0) {
            umaskshell(line->commands[0].argv, line->ncommands > 1);
            return;
        }
    }
    int i;
    int fd[2];
    int fd_in = -1; // Descriptor de entrada para el siguiente comando
    pid_t pid;
    pid_t pgid = 0; // PGID del pipeline (se establece con el PID del primer proceso)

    for (i = 0; i < line->ncommands; i++)
    {
        // Crear pipe si no es el último comando
        if (i < line->ncommands - 1)
        {
            if (pipe(fd) < 0)
            {
                perror("pipe");
                return;
            }
        }
        pid = fork();

        if (pid < 0)
        {
            perror("fork");
            return;
        }
        else if (pid == 0)
        {
            // Establecer el grupo de procesos
            if (i == 0)
            {
                // crear nuevo grupo de procesos para el primero con su propio PID
                setpgid(0, 0);
            }
            else
            {
                // unirse al grupo del primer proceso
                setpgid(0, pgid);
            }

            // Restaurar señales por defecto para que el hijo pueda morir con Ctrl+C
            signal(SIGINT, SIG_DFL);
            signal(SIGTSTP, SIG_DFL);
            // signal(SIGCHLD, SIG_DFL); // El hijo no necesita manejar SIGCHLD

            // Configuración de tuberías
            if (fd_in != -1)
            {
                dup2(fd_in, STDIN_FILENO);
                close(fd_in);
            }
            if (i < line->ncommands - 1)
            {
                dup2(fd[1], STDOUT_FILENO);
                close(fd[1]);
                close(fd[0]); // El hijo no lee de este pipe
            }
            // Aplicar redirecciones (tu función)
            if (aplicar_redirecciones(line, i) == -1)
                exit(1);
            // Ejecutar
            execvp(line->commands[i].argv[0], line->commands[i].argv);
            
            // CORRECCIÓN DEL MENSAJE DE ERROR SEGÚN PDF 
            // "Si alguno de los mandatos a ejecutar no existe..."
            printf("%s: No se encuentra el mandato\n", line->commands[i].argv[0]);
            exit(1);
        }
        else
        {
            // Establecer el grupo de procesos desde el padre (para evitar race conditions)
            if (i == 0)
            {
                // Primer proceso: establecer como líder del grupo
                pgid = pid;
                setpgid(pid, pid);
                /* Si es foreground, dar inmediatamente control del terminal al
                   nuevo grupo para evitar que el hijo sea parado por SIGTTIN */
                if (!line->background)
                {
                    if (tcsetpgrp(STDIN_FILENO, pgid) < 0)
                    {
                        /* Ignorar error */
                    }
                }
            }
            else
            {
                // Procesos subsecuentes: añadir al grupo existente
                setpgid(pid, pgid);
            }

            if (fd_in != -1)
                close(fd_in); // Cerrar el extremo de lectura del pipe anterior
            if (i < line->ncommands - 1)
            {
                close(fd[1]);  // Cerrar escritura del pipe actual
                fd_in = fd[0]; // Guardar lectura para la siguiente iteración
            }
        }
    }
    //Gestión de foreground/background
    if (line->background) {
        // Añadir el pipeline completo como un job usando el PGID
        char *cmd_str = get_command_string(line);
        add_job(pgid, cmd_str, RUNNING, line->ncommands);
    } else {
        // Fore ground: crear job temporal para poder manejar Ctrl+Z
        char *cmd_str = get_command_string(line);

        fg_pgid = pgid;

        // Esperar al grupo de procesos completo con WUNTRACED para detectar stops
        int status;
        pid_t result;
        
        // Esperar al grupo de procesos completo (todos los del pipeline)
        while (1) {
            result = waitpid(-pgid, &status, WUNTRACED);
            
            if (result > 0) {
                if (WIFSTOPPED(status)) {
                    // Job fue detenido con Ctrl+Z - agregarlo a la lista
                    add_job(pgid, cmd_str, STOPPED);
                    fg_pgid = 0;
                    return; // Salir sin liberar cmd_str (el job lo necesita)
                } else if (WIFEXITED(status) || WIFSIGNALED(status)) {
                    // Un proceso terminó - verificar si quedan más
                    if (kill(-pgid, 0) < 0) {
                        // El grupo ya no existe - todos terminaron
                        break;
                    }
                    // Si quedan procesos, continuar esperando
                }
            }
            else if (result < 0)
            {
                // Error o no hay más procesos que esperar
                break;
            }
        }

        /* Restaurar control del terminal a la minishell */
        tcsetpgrp(STDIN_FILENO, getpid());
        fg_pgid = 0;
        free(cmd_str); // Liberar si el job terminó normalmente
    }
}

// Free memory allocated for tline structure
// NOTE: Do NOT free internal fields (argv, filename, redirects)
// as they belong to the parser library
void free_line(tline *line) {
    if (line == NULL) return;
    // Only free the tline structure itself
    free(line);
}

int main()
{


    char buffer[1024];
    tline *line;
    init_jobs();
    activarsignal();
    while (1)
    {
        // Actualizar estados de jobs antes de mostrar el prompt
        zombies();

        printf("msh> ");
        if (fgets(buffer, sizeof(buffer), stdin) == NULL)
        {
            break; // Salir si hay un error o EOF
        }
        line = tokenize(buffer);
        if (line == NULL || line->ncommands == 0) {
            if (line != NULL) free_line(line);
            continue;
        }
        ejecutar_linea(line);

        // Liberar la memoria asignada para 'line'
        free_line(line);
    }
    return 0;
}
