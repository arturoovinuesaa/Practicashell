int aplicar_redirecciones(tline *line, int cmd_index)
{
    int fd;
    if (cmd_index == 0 && line->redirect_input != NULL)
    {
        fd = open(line->redirect_input, O_RDONLY);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_input, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDIN_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }
    if (cmd_index == line->ncommands - 1 && line->redirect_output != NULL)
    {
        fd = open(line->redirect_output, O_WRONLY | O_CREAT | O_TRUNC, 0666);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_output, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDOUT_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }
    if (cmd_index == line->ncommands - 1 && line->redirect_error != NULL)
    {
        fd = open(line->redirect_error, O_WRONLY | O_CREAT | O_TRUNC, 0666);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_error, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDERR_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }

    return 0;
}

int ejecutar_comando(tline *line, int background)
{
    // comprobar si el comando existe lo mandas al execv
    if (line->ncommands == 1 && line->commands[0].argv[0] != NULL && strcmp(line->commands[0].argv[0], "exit") == 0)
    {
        exitshell();
        return 0;
    }
    if (line->commands[0].argv[0] != NULL && strcmp(line->commands[0].argv[0], "cd") == 0)
    {
        cdshell(line->commands[0].argv[1]);
        return 0;
        printf("comando cd\n");
    }

    /* Ejecutar primer (o único) comando de la línea. Más adelante se
       implementarán pipelines y demás. */
    tcommand *cmd = &line->commands[0];
    if (cmd->filename == NULL)
    {
        fprintf(stderr, "%s: No se encuentra el mandato\n", cmd->argv[0] ? cmd->argv[0] : "(null)");
        return -1;
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        perror("Error del fork");
        return -1;
    }
    else if (pid == 0)
    {
        // Proceso hijo
        aplicar_redirecciones(line, 0);
        execvp(cmd->filename, cmd->argv);
        perror("comando fallido");
        exit(EXIT_FAILURE);
    }
    else
    {
        int status = 0;
        if (background)
        {
            printf("[%d]\n", (int)pid);
        }
        else
        {
            waitpid(pid, &status, 0);
        }
        return status;
    }
}

