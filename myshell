#define _GNU_SOURCE
#include "parser.h"
#include <errno.h>
#include <fcntl.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <unistd.h>

#define MAX_JOBS 100
#define STATUS_RUNNING "Running"
#define STATUS_STOPPED "Stopped"
#define STATUS_DONE "Done"
typedef struct {
  pid_t pgid;
  pid_t leader;
  int id;
  char *cmd;
  char status[16];
} job_t;

static job_t jobs[MAX_JOBS];
static int next_job_id = 1;
static pid_t fg_pgid = 0;

void init_jobs(void) {
  int i;
  for (i = 0; i < MAX_JOBS; i++) {
    jobs[i].pgid = 0;
    jobs[i].leader = 0;
    jobs[i].cmd = NULL;
    jobs[i].id = 0;
    jobs[i].status[0] = '\0';
  }
}

char *build_command(tline *line) {
  int i, j;
  int len = 0;
  char *res;

  for (i = 0; i < line->ncommands; i++) {
    for (j = 0; line->commands[i].argv[j]; j++) {
      len += strlen(line->commands[i].argv[j]) + 1;
    }
    if (i < line->ncommands - 1) {
      len += 2; /* "| " */
    }
  }
  if (line->background) {
    len += 1; /* '&' */
  }

  res = malloc(len + 1);
  if (!res)
    return NULL;
  res[0] = '\0';

  for (i = 0; i < line->ncommands; i++) {
    if (i > 0) {
      strcat(res, "| ");
    }
    for (j = 0; line->commands[i].argv[j]; j++) {
      strcat(res, line->commands[i].argv[j]);
      strcat(res, " ");
    }
  }
  if (line->background) {
    strcat(res, "&");
  }

  return res;
}

void add_job(pid_t pgid, pid_t leader, char *cmd, const char *status) {
  int i;

  for (i = 0; i < MAX_JOBS; i++) {
    if (jobs[i].pgid == 0) {
      jobs[i].pgid = pgid;
      jobs[i].leader = leader;
      jobs[i].id = next_job_id++;
      jobs[i].cmd = cmd;
      strncpy(jobs[i].status, status, sizeof(jobs[i].status) - 1);
      jobs[i].status[sizeof(jobs[i].status) - 1] = '\0';

      printf("\n[%d]+ %s    %s\n", jobs[i].id, jobs[i].status, jobs[i].cmd);
      return;
    }
  }

  fprintf(stderr, "msh: demasiados jobs\n");
  if (cmd)
    free(cmd);
}

void remove_job_index(int idx) {
  if (idx < 0 || idx >= MAX_JOBS)
    return;
  if (jobs[idx].pgid == 0)
    return;

  if (jobs[idx].cmd) {
    free(jobs[idx].cmd);
    jobs[idx].cmd = NULL;
  }
  jobs[idx].pgid = 0;
  jobs[idx].leader = 0;
  jobs[idx].id = 0;
  jobs[idx].status[0] = '\0';
}

job_t *find_job_by_id(int id) {
  int i;
  for (i = 0; i < MAX_JOBS; i++) {
    if (jobs[i].pgid != 0 && jobs[i].id == id) {
      return &jobs[i];
    }
  }
  return NULL;
}

job_t *find_last_stopped_job(void) {
  int i;
  job_t *res = NULL;

  for (i = 0; i < MAX_JOBS; i++) {
    if (jobs[i].pgid != 0 && strcmp(jobs[i].status, STATUS_STOPPED) == 0) {
      if (res == NULL || jobs[i].id > res->id) {
        res = &jobs[i];
      }
    }
  }
  return res;
}

/* ---------- builtins ---------- */

void builtin_cd(char *path) {
  char cwd[1024];

  if (path == NULL) {
    path = getenv("HOME");
    if (path == NULL) {
      fprintf(stderr, "msh: cd: HOME no definido\n");
      return;
    }
  }

  if (chdir(path) < 0) {
    perror("msh: cd");
  } else {
    if (getcwd(cwd, sizeof(cwd))) {
      printf("%s\n", cwd);
    }
  }
}

void builtin_jobs(void) {
  int i;

  for (i = 0; i < MAX_JOBS; i++) {
    if (jobs[i].pgid != 0) {
      int is_done;
      char *cmd_to_print;

      is_done = 0;
      if (strcmp(jobs[i].status, STATUS_DONE) == 0) {
        is_done = 1;
      }

      cmd_to_print = jobs[i].cmd;
      if (cmd_to_print == NULL) {
        cmd_to_print = "";
      }

      printf("[%d]+ %-8s %s\n", jobs[i].id, jobs[i].status, cmd_to_print);

      if (is_done) {
        remove_job_index(i);
      }
    }
  }
}

void builtin_bg(char *arg) {
  job_t *j;

  if (arg != NULL) {
    int id = atoi(arg);
    j = find_job_by_id(id);
  } else {
    j = find_last_stopped_job();
  }

  if (j == NULL) {
    fprintf(stderr, "msh: bg: No hay trabajo\n");
    return;
  }

  if (strcmp(j->status, STATUS_STOPPED) != 0) {
    fprintf(stderr, "msh: bg: job ya en marcha\n");
    return;
  }

  if (kill(-j->pgid, SIGCONT) < 0) {
    perror("msh: bg: SIGCONT");
    return;
  }

  strcpy(j->status, STATUS_RUNNING);

  if (j->cmd != NULL) {
    printf("[%d]+ %s &\n", j->id, j->cmd);
  } else {
    printf("[%d]+  &\n", j->id);
  }
}

void builtin_umask(char **argv) {
  mode_t m;
  long v;
  char *end;

  if (argv[1] == NULL) {
    m = umask(0);
    umask(m);
    printf("%04o\n", m);
  } else {
    v = strtol(argv[1], &end, 8);
    if (*end != '\0' || v < 0 || v > 0777) {
      fprintf(stderr, "msh: umask: valor invalido\n");
      return;
    }
    umask((mode_t)v);
  }
}

/* ---------- señales ---------- */

void sigint_handler() { write(STDOUT_FILENO, "\nmsh> ", 7); }

void sigtstp_handler() {
  if (fg_pgid > 0) {
    kill(-fg_pgid, SIGTSTP);
  }
  write(STDOUT_FILENO, "\nmsh> ", 7);
}

void sigchld_handler() {
  /* vacía: solo para notificar; recogemos en check_zombies */
}

void setup_signals(void) {
  signal(SIGINT, sigint_handler);
  signal(SIGTSTP, sigtstp_handler);
  signal(SIGCHLD, sigchld_handler);
  signal(SIGTTOU, SIG_IGN);
  signal(SIGTTIN, SIG_IGN);
}

/* recoger procesos terminados o parados de background */
void check_zombies(void) {
  int status;
  pid_t pid;
  int i;

  /* Recolectamos cambios sin bloquear */
  while ((pid = waitpid(-1, &status, WNOHANG | WUNTRACED | WCONTINUED)) > 0) {

    /* Para STOP/CONT el proceso sigue existiendo, así que getpgid() suele
     * funcionar */
    if (WIFSTOPPED(status) || WIFCONTINUED(status)) {
      pid_t g = getpgid(pid);
      if (g > 0) {
        for (i = 0; i < MAX_JOBS; i++) {
          if (jobs[i].pgid != 0 && jobs[i].pgid == g) {
            if (WIFSTOPPED(status)) {
              strcpy(jobs[i].status, STATUS_STOPPED);
              char *cmd_to_print = jobs[i].cmd;
              if (cmd_to_print == NULL)
                cmd_to_print = "";
              printf("[%d]+ Stopped             %s\n", jobs[i].id,
                     cmd_to_print);
            } else {
              strcpy(jobs[i].status, STATUS_RUNNING);
            }
            break;
          }
        }
      }
    }

    /* Si ha EXIT/SIGNALED, aquí NO usamos getpgid(pid) porque puede fallar tras
     * waitpid() */
    /* Lo de "Done" lo decidimos abajo comprobando si el grupo sigue existiendo
     */
  }

  /* Segunda pasada: si el grupo ya no existe -> Done */
  for (i = 0; i < MAX_JOBS; i++) {
    if (jobs[i].pgid != 0 && strcmp(jobs[i].status, STATUS_DONE) != 0) {
      if (kill(-jobs[i].pgid, 0) < 0 && errno == ESRCH) {
        strcpy(jobs[i].status, STATUS_DONE);
        char *cmd_to_print = jobs[i].cmd;
        if (cmd_to_print == NULL)
          cmd_to_print = "";
        printf("[%d]+ Done                %s\n", jobs[i].id, cmd_to_print);
        /* NO lo borres aquí; ya lo borras en builtin_jobs() si quieres */
      }
    }
  }
}

/* ---------- redirecciones ---------- */
int apply_redirs(tline *l, int pos_cmd) {
  int fd;

  if (pos_cmd == 0 && l->redirect_input) {
    fd = open(l->redirect_input, O_RDONLY);
    if (fd < 0) {
      fprintf(stderr, "%s: error de entrada\n", l->redirect_input);
      return -1;
    }
    dup2(fd, STDIN_FILENO);
    close(fd);
  }

  if (pos_cmd == l->ncommands - 1 && l->redirect_output) {
    fd = open(l->redirect_output, O_CREAT | O_WRONLY | O_TRUNC, 0666);
    if (fd < 0) {
      fprintf(stderr, "%s: error de salida\n", l->redirect_output);
      return -1;
    }
    dup2(fd, STDOUT_FILENO);
    close(fd);
  }

  if (pos_cmd == l->ncommands - 1 && l->redirect_error) {
    fd = open(l->redirect_error, O_CREAT | O_WRONLY | O_TRUNC, 0666);
    if (fd < 0) {
      fprintf(stderr, "%s: error de redirección\n", l->redirect_error);
      return -1;
    }
    dup2(fd, STDERR_FILENO);
    close(fd);
  }

  return 0;
}

/* ---------- ejecución ---------- */

void execute_line(tline *l) {
  int i;
  int fd[2];
  int in_fd = -1;
  pid_t pid;
  pid_t pgid = 0;
  int status;
  char *cmd_copy;

  if (l->ncommands == 0)
    return;

  /* builtins simples sin pipe */
  if (l->ncommands == 1) {
    char *name = l->commands[0].argv[0];

    if (strcmp(name, "exit") == 0) {
      exit(0);
    } else if (strcmp(name, "cd") == 0) {
      builtin_cd(l->commands[0].argv[1]);
      return;
    } else if (strcmp(name, "jobs") == 0) {
      builtin_jobs();
      return;
    } else if (strcmp(name, "bg") == 0) {
      builtin_bg(l->commands[0].argv[1]);
      return;
    } else if (strcmp(name, "umask") == 0) {
      builtin_umask(l->commands[0].argv);
      return;
    }
  }

  for (i = 0; i < l->ncommands; i++) {
    if (i < l->ncommands - 1) {
      if (pipe(fd) < 0) {
        perror("pipe");
        return;
      }
    }

    pid = fork();
    if (pid < 0) {
      perror("fork");
      return;
    }

    if (pid == 0) { /* hijo */
      signal(SIGINT, SIG_DFL);
      signal(SIGTSTP, SIG_DFL);
      signal(SIGCHLD, SIG_DFL);

      if (i == 0) {
        pgid = getpid();
      }
      setpgid(0, pgid);

      if (in_fd != -1) {
        dup2(in_fd, STDIN_FILENO);
        close(in_fd);
      }

      if (i < l->ncommands - 1) {
        dup2(fd[1], STDOUT_FILENO);
        close(fd[0]);
        close(fd[1]);
      }

      if (apply_redirs(l, i) < 0) {
        exit(1);
      }

      execvp(l->commands[i].argv[0], l->commands[i].argv);
      fprintf(stderr, "%s: No se encuentra el comando\n",
              l->commands[i].argv[0]);
      exit(1);
    }

    /* padre */
    if (i == 0) {
      pgid = pid;
    }
    setpgid(pid, pgid);

    if (in_fd != -1) {
      close(in_fd);
    }
    if (i < l->ncommands - 1) {
      close(fd[1]);
      in_fd = fd[0];
    }
  }

  if (l->background) {
    cmd_copy = build_command(l);
    add_job(pgid, pgid, cmd_copy, STATUS_RUNNING);
  } else {
    fg_pgid = pgid;
    tcsetpgrp(STDIN_FILENO, pgid);

    while (1) {
      pid = waitpid(-pgid, &status, WUNTRACED);
      if (pid < 0) {
        if (errno == ECHILD)
          break;
        else
          continue;
      }
      if (WIFSTOPPED(status)) {
        /* grupo parado, lo pasamos a jobs */
        cmd_copy = build_command(l);
        tcsetpgrp(STDIN_FILENO, getpid());
        fg_pgid = 0;
        add_job(pgid, pgid, cmd_copy, STATUS_STOPPED);
        return;
      }
    }

    tcsetpgrp(STDIN_FILENO, getpid());
    fg_pgid = 0;
  }
}

/* ---------- main ---------- */

int main(void) {
  char buf[1024];
  tline *line;

  init_jobs();
  setup_signals();

  while (1) {
    check_zombies();
    printf("msh> ");
    fflush(stdout);

    if (!fgets(buf, sizeof(buf), stdin)) {
      break;
    }

    line = tokenize(buf);
    if (!line || line->ncommands == 0) {
      continue;
    }

    execute_line(line);
  }

  return 0;
}
