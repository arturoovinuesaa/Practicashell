void cdshell(char *path)
{
    char *dir;
    char buffer[1024]; // Buffer para guardar la ruta actual
    if (path == NULL)
    {
        dir = getenv("HOME");
    }
    else
    {
        dir = path;
    }
    if (chdir(dir) != 0)
    {
        fprintf(stderr, "No existe el fichero o directorio <%s>\n", dir);
    }
    else
    {
        if (getcwd(buffer, sizeof(buffer)) != NULL)
        {
            printf("%s\n", buffer);
        }
    }
}
