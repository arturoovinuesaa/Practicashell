// tope de jobs, fijo, sin ganas de hacerlo dinamico
#define MAX_JOBS 100
#define STATUS_RUNNING "Running"
#define STATUS_STOPPED "Stopped"
#define STATUS_DONE "Done"
// struct del job, guarda ids y el comando
typedef struct {
  pid_t pgid;
  pid_t leader;
  int id;
  char *cmd;
  char status[16];
} job_t;

// tabla global, no es bonito pero funciona
static job_t jobs[MAX_JOBS];
// contador de ids
static int next_job_id = 1;
// pgid del foreground para controlar ctrl z
static pid_t fg_pgid = 0;

// inicializa la tabla de jobs
void init_jobs(void) {
  int i;
  for (i = 0; i < MAX_JOBS; i++) { // recorre la tabla
    jobs[i].pgid = 0;
    jobs[i].leader = 0;
    jobs[i].cmd = NULL;
    jobs[i].id = 0;
    jobs[i].status[0] = '\0';
  }
}

// arma un string con el comando para imprimirlo
char *build_command(tline *line) {
  int i, j;
  int len = 0;
  char *res;

  for (i = 0; i < line->ncommands; i++) {
    for (j = 0; line->commands[i].argv[j]; j++) {
      len += strlen(line->commands[i].argv[j]) + 1;
    }
    if (i < line->ncommands - 1) {
      len += 2;
    }
  }
  if (line->background) {
    len += 1;
  }

  res = malloc(len + 1);
  if (!res)      // si falla malloc, pues NULL
    return NULL; // no se pudo construir el comando
  res[0] = '\0';

  for (i = 0; i < line->ncommands; i++) {
    if (i > 0) {
      strcat(res, "| ");
    }
    for (j = 0; line->commands[i].argv[j]; j++) {
      strcat(res, line->commands[i].argv[j]);
      strcat(res, " ");
    }
  }
  if (line->background) {
    strcat(res, "&");
  }

  return res;
}

// mete un job en la tabla
void add_job(pid_t pgid, pid_t leader, char *cmd, const char *status) {
  int i;

  for (i = 0; i < MAX_JOBS; i++) { // recorre la tabla
    if (jobs[i].pgid == 0) {
      jobs[i].pgid = pgid;
      jobs[i].leader = leader;
      jobs[i].id = next_job_id++;
      jobs[i].cmd = cmd;
      strncpy(jobs[i].status, status, sizeof(jobs[i].status) - 1);
      jobs[i].status[sizeof(jobs[i].status) - 1] = '\0';

      printf("\n[%d]+ %s    %s\n", jobs[i].id, jobs[i].status, jobs[i].cmd);
      return;
    }
  }

  fprintf(stderr, "msh: demasiados jobs\n");
  if (cmd)
    free(cmd);
}

// borra un job y libera cmd
void remove_job_index(int idx) {
  if (idx < 0 || idx >= MAX_JOBS)
    return;
  if (jobs[idx].pgid == 0)
    return;

  if (jobs[idx].cmd) {
    free(jobs[idx].cmd);
    jobs[idx].cmd = NULL;
  }
  jobs[idx].pgid = 0;
  jobs[idx].leader = 0;
  jobs[idx].id = 0;
  jobs[idx].status[0] = '\0';
}

// busca un job por id
job_t *find_job_by_id(int id) {
  int i;
  for (i = 0; i < MAX_JOBS; i++) { // recorre la tabla
    if (jobs[i].pgid != 0 && jobs[i].id == id) {
      return &jobs[i];
    }
  }
  return NULL; // no se pudo construir el comando
}

// busca el ultimo stopped
job_t *find_last_stopped_job(void) {
  int i;
  job_t *res = NULL;

  for (i = 0; i < MAX_JOBS; i++) { // recorre la tabla
    if (jobs[i].pgid != 0 && strcmp(jobs[i].status, STATUS_STOPPED) == 0) {
      if (res == NULL || jobs[i].id > res->id) {
        res = &jobs[i];
      }
    }
  }
  return res;
}

// builtin cd, cambia el dir
void builtin_cd(char *path) {
  char cwd[1024];

  if (path == NULL) {
    path = getenv("HOME");
    if (path == NULL) {
      fprintf(stderr, "msh: cd: HOME no definido\n");
      return;
    }
  }

  if (chdir(path) < 0) {
    perror("msh: cd");
  } else {
    if (getcwd(cwd, sizeof(cwd))) {
      printf("%s\n", cwd);
    }
  }
}

// builtin jobs, lista y limpia done
void builtin_jobs(void) {
  int i;

  for (i = 0; i < MAX_JOBS; i++) { // recorre la tabla
    if (jobs[i].pgid != 0) {
      int is_done;
      char *cmd_to_print;

      is_done = 0;
      if (strcmp(jobs[i].status, STATUS_DONE) == 0) {
        is_done = 1;
      }

      cmd_to_print = jobs[i].cmd;
      if (cmd_to_print == NULL) {
        cmd_to_print = "";
      }

      printf("[%d]+ %-8s %s\n", jobs[i].id, jobs[i].status, cmd_to_print);

      if (is_done) {
        remove_job_index(i);
      }
    }
  }
}

// builtin bg, reanuda job
void builtin_bg(char *arg) {
  job_t *j;

  if (arg != NULL) {
    int id = atoi(arg);
    j = find_job_by_id(id);
  } else {
    j = find_last_stopped_job();
  }

  if (j == NULL) {
    fprintf(stderr, "msh: bg: No hay trabajo\n");
    return;
  }

  if (strcmp(j->status, STATUS_STOPPED) != 0) {
    fprintf(stderr, "msh: bg: job ya en marcha\n");
    return;
  }

  if (kill(-j->pgid, SIGCONT) < 0) {
    perror("msh: bg: SIGCONT");
    return;
  }

  strcpy(j->status, STATUS_RUNNING);

  if (j->cmd != NULL) {
    printf("[%d]+ %s &\n", j->id, j->cmd);
  } else {
    printf("[%d]+  &\n", j->id);
  }
}

// builtin umask, muestra o cambia
void builtin_umask(char **argv) {
  mode_t m;
  long v;
  char *end;

  if (argv[1] == NULL) {
    m = umask(0);
    umask(m);
    printf("%04o\n", m);
  } else {
    v = strtol(argv[1], &end, 8);
    if (*end != '\0' || v < 0 || v > 0777) {
      fprintf(stderr, "msh: umask: valor invalido\n");
      return;
    }
    umask((mode_t)v);
  }
}

// ctrl c, aqui solo reimprime el prompt
void sigint_handler() { write(STDOUT_FILENO, "\nmsh> ", 7); }

// ctrl z, manda SIGTSTP al grupo
void sigtstp_handler() {
  if (fg_pgid > 0) {
    kill(-fg_pgid, SIGTSTP);
  }
  write(STDOUT_FILENO, "\nmsh> ", 7);
}

// SIGCHLD, no hace nada real, solo para despertar
void sigchld_handler() {}

// instala handlers
void setup_signals(void) {
  signal(SIGINT, sigint_handler);
  signal(SIGTSTP, sigtstp_handler);
  signal(SIGCHLD, sigchld_handler);
  signal(SIGTTOU, SIG_IGN);
  signal(SIGTTIN, SIG_IGN);
}

// recoge hijos y actualiza estados
void check_zombies(void) {
  int status;
  pid_t pid;
  int i;

  while ((pid = waitpid(-1, &status, WNOHANG | WUNTRACED | WCONTINUED)) > 0) {

    if (WIFSTOPPED(status) ||
        WIFCONTINUED(status)) { // Si el proceso fue detenido Ctrl+Z
      pid_t g = getpgid(pid);
      if (g > 0) {
        for (i = 0; i < MAX_JOBS;
             i++) { // recorre la tabla para buscar el PGID que cambio
          if (jobs[i].pgid != 0 && jobs[i].pgid == g) {
            if (WIFSTOPPED(status)) { // si esta detenido, actualiza su estado e
                                      // imprime mensaje
              strcpy(jobs[i].status, STATUS_STOPPED);
              char *cmd_to_print = jobs[i].cmd;
              if (cmd_to_print == NULL)
                cmd_to_print = "";
              printf("[%d]+ Stopped             %s\n", jobs[i].id,
                     cmd_to_print);
            } else {
              strcpy(jobs[i].status,
                     STATUS_RUNNING); // si esta reanudado, actualiza su estado
            }
            break;
          }
        }
      }
    }
  }

  for (i = 0; i < MAX_JOBS; i++) { // recorre la tabla
    if (jobs[i].pgid != 0 && strcmp(jobs[i].status, STATUS_DONE) != 0) {
      if (kill(-jobs[i].pgid, 0) < 0 &&
          errno == ESRCH) { // si el proceso no existe, actualiza su estado
        strcpy(jobs[i].status, STATUS_DONE);
        char *cmd_to_print = jobs[i].cmd;
        if (cmd_to_print == NULL)
          cmd_to_print = "";
        printf("[%d]+ Done                %s\n", jobs[i].id, cmd_to_print);
      }
    }
  }
}

// redirecciones de entrada salida error
int apply_redirs(tline *l, int pos_cmd) {
  int fd;

  if (pos_cmd == 0 &&
      l->redirect_input) { // solo para el primer comando del pipeline
    fd = open(l->redirect_input, O_RDONLY);
    if (fd < 0) {
      fprintf(stderr, "%s: error de entrada\n", l->redirect_input);
      return -1; // error
    }
    dup2(fd, STDIN_FILENO); // dup2 hace que STDIN_FILENO apunte al mismo "open
                            // file description" que fd.
    close(fd);
  }

  if (pos_cmd == l->ncommands - 1 &&
      l->redirect_output) { // solo para el ultimo comando del pipeline
    fd = open(l->redirect_output, O_CREAT | O_WRONLY | O_TRUNC, 0666);
    if (fd < 0) {
      fprintf(stderr, "%s: error de salida\n", l->redirect_output);
      return -1; // error
    }
    dup2(fd, STDOUT_FILENO); // redirigir stdout (fd 1) al fichero.
    close(fd);
  }

  if (pos_cmd == l->ncommands - 1 &&
      l->redirect_error) { // redireccion de error
    fd = open(l->redirect_error, O_CREAT | O_WRONLY | O_TRUNC, 0666);
    if (fd < 0) {
      fprintf(stderr, "%s: error de redirección\n", l->redirect_error);
      return -1; // error
    }
    dup2(fd, STDERR_FILENO);
    close(fd);
  }

  return 0; // ok
}

// ejecuta una linea, con pipes y tsin ellos
void execute_line(tline *l) {
  int i;
  int fd[2]; // para el pipe
  int in_fd = -1;
  pid_t pid;
  pid_t pgid = 0; // id del grupo todos los comandos de este pipeline
                  // compartirán el mismo
  int status;
  char *cmd_copy;

  if (l->ncommands == 0) // si la linea esta vacia no hace nada
    return;

  if (l->ncommands == 1) { // si solo hay un comando no hace pipe
    char *name = l->commands[0].argv[0];
    // llama a la funcion que sea necesaria
    if (strcmp(name, "exit") == 0) {
      exit(0);
    } else if (strcmp(name, "cd") == 0) {
      builtin_cd(l->commands[0].argv[1]);
      return;
    } else if (strcmp(name, "jobs") == 0) {
      builtin_jobs();
      return;
    } else if (strcmp(name, "bg") == 0) {
      builtin_bg(l->commands[0].argv[1]);
      return;
    } else if (strcmp(name, "umask") == 0) {
      builtin_umask(l->commands[0].argv);
      return;
    }
  }

  for (i = 0; i < l->ncommands; i++) { // crea un fork por comando
    if (i < l->ncommands - 1) { // si no es el ultimo comando crea un pipe
      if (pipe(fd) < 0) {
        perror("pipe");
        return;
      }
    }

    pid = fork();
    if (pid < 0) {
      perror("fork");
      return;
    }

    if (pid == 0) { // codigo del hijo
      signal(SIGINT, SIG_DFL);
      signal(SIGTSTP, SIG_DFL); // restaura los handlers
      signal(SIGCHLD, SIG_DFL);

      if (i == 0) { // establece grupo de procesos
        pgid = getpid();
      }
      setpgid(0, pgid);

      if (in_fd != -1) { // si no es el primer comando redirecciona entrada
        dup2(in_fd, STDIN_FILENO);
        close(in_fd);
      }

      if (i <
          l->ncommands - 1) { // si no es el ultimo comando redirecciona salida
        dup2(fd[1], STDOUT_FILENO);
        close(fd[0]); // cerrar la lectura
        close(fd[1]); // cerrar la escritura, ya que ya esta duplicado en stout
      }

      if (apply_redirs(l, i) < 0) { // aplicar redirecciones si es necesario
        exit(1);
      }

      execvp(l->commands[i].argv[0], l->commands[i].argv); // remplazar hijo
      fprintf(stderr,
              "%s: No se encuentra el comando\n", ->commands[i].argv[0]);
      exit(1);
    }

    if (i == 0) { // codigo del padre
      pgid = pid;
    }
    setpgid(pid, pgid);

    if (in_fd != -1) {
      close(in_fd);
    }
    if (i < l->ncommands - 1) {
      close(fd[1]);
      in_fd = fd[0];
    }
  }

  if (l->background) { // ejecutar el background, si &, registrar el job y
                       // continuar
    cmd_copy = build_command(l);
    add_job(pgid, pgid, cmd_copy, STATUS_RUNNING);
  } else { // ejecutar de foreground,dar control del terminal al grupo de
           // procesos del pipeline
    fg_pgid = pgid;
    tcsetpgrp(STDIN_FILENO, pgid);

    while (1) { // esperar a que todos los procesos del grupo terminen
      pid = waitpid(-pgid, &status, WUNTRACED);
      if (pid < 0) { // Si ya no quedan hijos, termina el pipeline
        break;
        else continue;
      }
      if (WIFSTOPPED(status)) { // Si se detuvo, registrar el job y continuar
        cmd_copy = build_command(l);
        tcsetpgrp(STDIN_FILENO, getpid());
        fg_pgid = 0;
        add_job(pgid, pgid, cmd_copy, STATUS_STOPPED);
        return;
      }
    }
    tcsetpgrp(STDIN_FILENO, getpid()); // El pipeline termino normalmente:
                                       // recuperar control del terminal.
    fg_pgid = 0;
  }
}

// bucle principal, lee linea y ejecuta
int main() {
  char buf[1024];
  tline *line;
  init_jobs();     // inicializa la tabla de jobs
  setup_signals(); // configura los handlers

  while (1) {
    check_zombies(); // comprueba si hay zombies
    printf("msh> ");
    fflush(stdout); // fuerza a que se imprima
    if (!fgets(buf, sizeof(buf), stdin)) {
      break;
    }
    line = tokenize(buf); // tokeniza la linea
    if (!line || line->ncommands == 0) {
      continue;
    }
    execute_line(line);
  }
  return 0; // ok
}
