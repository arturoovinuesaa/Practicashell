int aplicar_redirecciones(tline *line, int cmd_index)
{
    int fd;
    if (cmd_index == 0 && line->redirect_input != NULL)
    {
        fd = open(line->redirect_input, O_RDONLY);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_input, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDIN_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }
    if (cmd_index == line->ncommands - 1 && line->redirect_output != NULL)
    {
        fd = open(line->redirect_output, O_WRONLY | O_CREAT | O_TRUNC, 0666);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_output, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDOUT_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }
    if (cmd_index == line->ncommands - 1 && line->redirect_error != NULL)
    {
        fd = open(line->redirect_error, O_WRONLY | O_CREAT | O_TRUNC, 0666);
        if (fd == -1)
        {
            fprintf(stderr, "%s: Error. %s\n",
                    line->redirect_error, strerror(errno));
            return -1;
        }

        if (dup2(fd, STDERR_FILENO) == -1)
        {
            fprintf(stderr, "Error en dup2: %s\n", strerror(errno));
            close(fd);
            return -1;
        }
        close(fd);
    }

    return 0;
}

void ejecutar_linea(tline *line) {
    // 1. Comandos internos (built-ins) que deben ejecutarse en el proceso padre
    if (line->ncommands == 1) {
        if (strcmp(line->commands[0].argv[0], "exit") == 0) exitshell();
        if (strcmp(line->commands[0].argv[0], "cd") == 0) {
            cdshell(line->commands[0].argv[1]);
            return;
        }
        // Agrega jobs, fg, bg aquí si son built-ins
    }
    int i;
    int fd[2];
    int fd_in = -1; // Descriptor de entrada para el siguiente comando
    pid_t pid;

    for (i = 0; i < line->ncommands; i++) {
        // Crear pipe si no es el último comando
        if (i < line->ncommands - 1) {
            if (pipe(fd) < 0) {
                perror("pipe");
                return;
            }
        }
        pid = fork();

        if (pid < 0) {
            perror("fork");
            return;
        } else if (pid == 0) {
            // Restaurar señales por defecto para que el hijo pueda morir con Ctrl+C
            signal(SIGINT, SIG_DFL);
            signal(SIGTSTP, SIG_DFL); 
            // signal(SIGCHLD, SIG_DFL); // El hijo no necesita manejar SIGCHLD

            // Configuración de tuberías
            if (fd_in != -1) {
                dup2(fd_in, STDIN_FILENO);
                close(fd_in);
            }
            if (i < line->ncommands - 1) {
                dup2(fd[1], STDOUT_FILENO);
                close(fd[1]);
                close(fd[0]); // El hijo no lee de este pipe
            }
            // Aplicar redirecciones (tu función)
            if (aplicar_redirecciones(line, i) == -1) exit(1);
            // Ejecutar
            execvp(line->commands[i].argv[0], line->commands[i].argv);
            // Si execvp falla:
            fprintf(stderr, "msh: %s: %s\n", line->commands[i].argv[0], strerror(errno));
            exit(1);
        } else {
            if (fd_in != -1) close(fd_in); // Cerrar el extremo de lectura del pipe anterior
            if (i < line->ncommands - 1) {
                close(fd[1]); // Cerrar escritura del pipe actual
                fd_in = fd[0]; // Guardar lectura para la siguiente iteración
            }
            // Si es background, imprimir PID del último comando
            if (line->background && i == line->ncommands - 1) {
                printf("[%d]\n", pid);
            }
        }
    }
    if (!line->background) {
        for (i = 0; i < line->ncommands; i++) {
            wait(NULL);
        }
    }
}

